# ============================================================
# FeastFlow Platform API - Local Environment Configuration
# ============================================================

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:4200

# Customer storefront domains
CUSTOMER_APP_BASE_DOMAIN=localhost
# Stable public IPv4 address of the web ingress/reverse proxy.
CUSTOM_DOMAIN_A_TARGET=203.0.113.10
PUBLIC_CUSTOMER_URL=http://localhost:3003
GOOGLE_CLIENT_ID=

# Database
DATABASE_URL=postgresql://feastflow:change-me@127.0.0.1:5432/feastflow

# Encrypts restaurant-owned PayPal payout credentials at rest.
# Generate with: openssl rand -base64 32
PAYOUT_CREDENTIALS_ENCRYPTION_KEY=

# QZ Tray Premium silent-print signing (mount files as read-only secrets)
QZ_SIGNING_ENABLED=false
QZ_CERTIFICATE_PATH=/run/secrets/qz_certificate
QZ_PRIVATE_KEY_PATH=/run/secrets/qz_private_key

# Email Verification
EMAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=example@domain.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=example@domain.com

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# AWS S3 Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=feastflow-local
AWS_PUBLIC_BASE_URL=
AWS_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=http://localhost:3003/payment/success
STRIPE_CANCEL_URL=http://localhost:3003/payment/cancel

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=
