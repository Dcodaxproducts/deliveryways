# Copy to /opt/deliveryway/env/.env.staging and replace every REPLACE_WITH value.
# Never commit the completed server file.

# Compose input
DELIVERYWAY_ENV_FILE=/opt/deliveryway/env/.env.staging
EXPECTED_HOSTNAME=REPLACE_WITH_SERVER_HOSTNAME
EXPECTED_SERVER_IPV4=REPLACE_WITH_SERVER_IPV4
POSTGRES_DB=deliveryway_staging
POSTGRES_USER=deliveryway_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD
DATABASE_URL=postgresql://deliveryway_staging:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/deliveryway_staging

# Immutable application images
API_IMAGE=REPLACE_WITH_STAGING_API_IMAGE_SHA
MIGRATION_IMAGE=REPLACE_WITH_STAGING_MIGRATION_IMAGE_SHA
RESTAURANT_ADMIN_IMAGE=REPLACE_WITH_STAGING_RESTAURANT_ADMIN_IMAGE_SHA
SUPERADMIN_IMAGE=REPLACE_WITH_STAGING_SUPERADMIN_IMAGE_SHA
CUSTOMER_IMAGE=REPLACE_WITH_STAGING_CUSTOMER_IMAGE_SHA
LANDING_IMAGE=REPLACE_WITH_STAGING_LANDING_IMAGE_SHA

# Public staging URLs (compiled into the Next.js images)
PUBLIC_API_ROOT_URL=https://api.staging.REPLACE_WITH_DOMAIN/api
PUBLIC_API_BASE_URL=https://api.staging.REPLACE_WITH_DOMAIN/api/v1
PUBLIC_RESTAURANT_ADMIN_URL=https://admin.staging.REPLACE_WITH_DOMAIN
PUBLIC_CUSTOMER_URL=https://staging.REPLACE_WITH_DOMAIN
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
GOOGLE_MAPS_API_KEY=REPLACE_WITH_STAGING_GOOGLE_MAPS_API_KEY

# Backend application
CORS_ORIGINS=https://admin.staging.REPLACE_WITH_DOMAIN,https://superadmin.staging.REPLACE_WITH_DOMAIN,https://staging.REPLACE_WITH_DOMAIN
CUSTOMER_APP_BASE_DOMAIN=staging.REPLACE_WITH_DOMAIN
DATABASE_LOGGING=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
SYSTEM_HEALTH_STORE_PATH=/app/storage/system-health/metrics.json

# Authentication
JWT_ACCESS_SECRET=REPLACE_WITH_STAGING_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STAGING_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Email
EMAIL_ENABLED=false
MAIL_HOST=REPLACE_WITH_STAGING_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_STAGING_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_STAGING_SMTP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=REPLACE_WITH_STAGING_FROM_ADDRESS

# Object storage
AWS_ACCESS_KEY_ID=REPLACE_WITH_STAGING_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_AWS_SECRET_KEY
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_BUCKET_NAME=REPLACE_WITH_STAGING_BUCKET
AWS_PUBLIC_BASE_URL=REPLACE_WITH_STAGING_STORAGE_PUBLIC_URL
AWS_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300

# Payments (test mode only in staging)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STAGING_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=eur
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_ENVIRONMENT=SANDBOX

# Push notifications; use a dedicated staging Firebase project/key.
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_SINGLE_LINE_STAGING_FIREBASE_JSON
