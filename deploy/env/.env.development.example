# Copy to /opt/deliveryway/env/.env.development and replace every REPLACE_WITH value.
# Never commit the completed server file.

# Compose input
DELIVERYWAY_ENV_FILE=/opt/deliveryway/env/.env.development
EXPECTED_HOSTNAME=REPLACE_WITH_SERVER_HOSTNAME
EXPECTED_SERVER_IPV4=REPLACE_WITH_SERVER_IPV4
POSTGRES_DB=deliveryway_development
POSTGRES_USER=deliveryway_development
POSTGRES_PASSWORD=REPLACE_WITH_DEVELOPMENT_DATABASE_PASSWORD
DATABASE_URL=postgresql://deliveryway_development:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/deliveryway_development

# Immutable application images
API_IMAGE=REPLACE_WITH_DEVELOPMENT_API_IMAGE_SHA
MIGRATION_IMAGE=REPLACE_WITH_DEVELOPMENT_MIGRATION_IMAGE_SHA
RESTAURANT_ADMIN_IMAGE=REPLACE_WITH_DEVELOPMENT_RESTAURANT_ADMIN_IMAGE_SHA
SUPERADMIN_IMAGE=REPLACE_WITH_DEVELOPMENT_SUPERADMIN_IMAGE_SHA
CUSTOMER_IMAGE=REPLACE_WITH_DEVELOPMENT_CUSTOMER_IMAGE_SHA
LANDING_IMAGE=REPLACE_WITH_DEVELOPMENT_LANDING_IMAGE_SHA

# Public development URLs (compiled into the Next.js images)
PUBLIC_API_ROOT_URL=https://api.dev.REPLACE_WITH_DOMAIN/api
PUBLIC_API_BASE_URL=https://api.dev.REPLACE_WITH_DOMAIN/api/v1
PUBLIC_RESTAURANT_ADMIN_URL=https://admin.dev.REPLACE_WITH_DOMAIN
PUBLIC_CUSTOMER_URL=https://dev.REPLACE_WITH_DOMAIN
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Backend application
CORS_ORIGINS=https://admin.dev.REPLACE_WITH_DOMAIN,https://superadmin.dev.REPLACE_WITH_DOMAIN,https://dev.REPLACE_WITH_DOMAIN
CUSTOMER_APP_BASE_DOMAIN=dev.REPLACE_WITH_DOMAIN
DATABASE_LOGGING=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
SYSTEM_HEALTH_STORE_PATH=/app/storage/system-health/metrics.json

# Authentication; migrate the legacy values to preserve existing app sessions.
JWT_ACCESS_SECRET=REPLACE_WITH_LEGACY_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LEGACY_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Outbound email stays disabled while old and new environments coexist.
EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=

# Object storage is optional until dedicated development credentials are installed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_PUBLIC_BASE_URL=
AWS_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300

# Development accepts Stripe test-mode credentials only.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_DEVELOPMENT_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=https://dev.REPLACE_WITH_DOMAIN/payment/success
STRIPE_CANCEL_URL=https://dev.REPLACE_WITH_DOMAIN/payment/cancel

# Push remains disabled until a dedicated development Firebase key is installed.
FIREBASE_SERVICE_ACCOUNT_JSON=
