# Copy to /opt/deliveryway/env/.env.production and replace every REPLACE_WITH value.
# Never commit the completed server file.

# Compose input
DELIVERYWAY_ENV_FILE=/opt/deliveryway/env/.env.production
EXPECTED_HOSTNAME=REPLACE_WITH_SERVER_HOSTNAME
EXPECTED_SERVER_IPV4=REPLACE_WITH_SERVER_IPV4
POSTGRES_DB=deliveryway_prod
POSTGRES_USER=deliveryway_prod
POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD
DATABASE_URL=postgresql://deliveryway_prod:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/deliveryway_prod

# Immutable application images promoted from staging
API_IMAGE=REPLACE_WITH_VERIFIED_API_IMAGE_SHA
RESTAURANT_ADMIN_IMAGE=REPLACE_WITH_VERIFIED_RESTAURANT_ADMIN_IMAGE_SHA
SUPERADMIN_IMAGE=REPLACE_WITH_VERIFIED_SUPERADMIN_IMAGE_SHA
CUSTOMER_IMAGE=REPLACE_WITH_VERIFIED_CUSTOMER_IMAGE_SHA
LANDING_IMAGE=REPLACE_WITH_VERIFIED_LANDING_IMAGE_SHA

# Public production URLs (compiled into the Next.js images)
PUBLIC_API_ROOT_URL=https://api.REPLACE_WITH_DOMAIN/api
PUBLIC_API_BASE_URL=https://api.REPLACE_WITH_DOMAIN/api/v1
PUBLIC_RESTAURANT_ADMIN_URL=https://admin.REPLACE_WITH_DOMAIN
PUBLIC_CUSTOMER_URL=https://REPLACE_WITH_DOMAIN
GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_MAPS_API_KEY=REPLACE_WITH_PRODUCTION_GOOGLE_MAPS_API_KEY

# Backend application
CORS_ORIGINS=https://admin.REPLACE_WITH_DOMAIN,https://superadmin.REPLACE_WITH_DOMAIN,https://REPLACE_WITH_DOMAIN
CUSTOMER_APP_BASE_DOMAIN=REPLACE_WITH_DOMAIN
DATABASE_LOGGING=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
SYSTEM_HEALTH_STORE_PATH=/app/storage/system-health/metrics.json

# Authentication
JWT_ACCESS_SECRET=REPLACE_WITH_PRODUCTION_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_PRODUCTION_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Email
EMAIL_ENABLED=true
MAIL_HOST=REPLACE_WITH_PRODUCTION_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_PRODUCTION_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_PRODUCTION_SMTP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=REPLACE_WITH_PRODUCTION_FROM_ADDRESS

# Object storage
AWS_ACCESS_KEY_ID=REPLACE_WITH_PRODUCTION_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_PRODUCTION_AWS_SECRET_KEY
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_BUCKET_NAME=REPLACE_WITH_PRODUCTION_BUCKET
AWS_PUBLIC_BASE_URL=REPLACE_WITH_PRODUCTION_STORAGE_PUBLIC_URL
AWS_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300

# Payments (live mode only after final approval)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_LIVE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=eur

# Push notifications; rotate the production Firebase key before installation.
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_SINGLE_LINE_PRODUCTION_FIREBASE_JSON
