generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_ADMIN
  BRANCH_ADMIN
  CUSTOMER
  STAFF
}

enum StaffPanelType {
  SUPER_ADMIN
  BUSINESS_ADMIN
  BRANCH_ADMIN
}

enum AddressRefType {
  TENANT
  RESTAURANT
  BRANCH
  USER
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  READY_TO_SERVE
  SERVED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum CouponStatus {
  ACTIVE
  SUSPENDED
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

enum OrderType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum MenuItemPricingMode {
  SINGLE
  MULTIPLE
}

enum PaymentMethod {
  COD
  STRIPE
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REFUND
  PAYMENT_REVERSAL
  LOYALTY_REDEMPTION
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  RESTORE
  ADJUSTMENT
  EXPIRE
}

enum LoyaltyRedemptionTarget {
  WALLET
  ORDER_DISCOUNT
}

enum PosActorType {
  USER
  STAFF
}

enum PosOrderDraftStatus {
  OPEN
  CHECKED_OUT
  CANCELLED
}

enum VatHandlingRule {
  INCLUSIVE
  EXCLUSIVE
  COMPLETED_TRANSACTIONS_ONLY
}

enum CurrencyDisplayFormat {
  SYMBOL_AMOUNT
  AMOUNT_CODE
  CODE_AMOUNT
}

enum PlatformDateFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationAudience {
  CUSTOMER
  ADMIN
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  PAYMENT_ATTEMPT_CREATED
  PAYMENT_PAID
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  PAYMENT_REFUNDED
}

enum DeliverymanStatus {
  OFFLINE
  AVAILABLE
  BUSY
  INACTIVE
}

enum ChatThreadStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ChatThreadSource {
  SUPPORT
  ORDER
  DELIVERY
}

enum ChatMessageSenderType {
  CUSTOMER
  ADMIN
  STAFF
  DELIVERYMAN
}

enum GroupOrderStatus {
  OPEN
  LOCKED
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum GroupOrderParticipantStatus {
  ACTIVE
  LEFT
  REMOVED
}

model Tenant {
  id             String    @id @default(cuid())
  name           String
  ownerId        String?   @map("owner_id")
  slug           String    @unique
  bio            String?
  logoUrl        String?   @map("logo_url")
  socialLinks    Json?     @map("social_links")
  brandingConfig Json?     @map("branding_config")
  settings       Json?
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner         User?                @relation("TenantOwner", fields: [ownerId], references: [id])
  restaurants   Restaurant[]
  branches      Branch[]
  users         User[]               @relation("TenantUsers")
  staffRoles    StaffRole[]
  staffUsers    StaffUser[]
  coupons       Coupon[]
  carts         Cart[]
  orders        Order[]
  transactions        PaymentTransaction[]
  walletAccounts      WalletAccount[]
  walletTransactions  WalletTransaction[]
  loyaltyPrograms     LoyaltyProgram[]
  loyaltyAccounts     LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  deliverymen   Deliveryman[]
  chatThreads   ChatThread[]
  groupOrders   GroupOrderSession[]
  posOrderDrafts PosOrderDraft[]

  @@map("tenants")
}

model Restaurant {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  name           String
  slug           String    @unique
  logoUrl        String?   @map("logo_url")
  coverImage     String?   @map("cover_image")
  customDomain   String?   @map("custom_domain")
  tagline        String?
  bio            String?
  supportContact Json?     @map("support_contact")
  branding       Json?
  socialMedia    Json?     @map("social_media")
  settings       Json?
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  branches            Branch[]
  users               User[]               @relation("RestaurantUsers")
  staffRoles          StaffRole[]
  staffUsers          StaffUser[]
  restaurantMenus     RestaurantMenu[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  modifierGroups      ModifierGroup[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  coupons             Coupon[]
  carts               Cart[]
  orders              Order[]
  transactions        PaymentTransaction[]
  walletAccounts      WalletAccount[]
  walletTransactions  WalletTransaction[]
  loyaltyPrograms     LoyaltyProgram[]
  loyaltyAccounts     LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  deliverymen         Deliveryman[]
  chatThreads         ChatThread[]
  groupOrders         GroupOrderSession[]
  posOrderDrafts      PosOrderDraft[]

  @@map("restaurants")
}

model Branch {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  tenantId     String    @map("tenant_id")
  name         String
  logoUrl      String?   @map("logo_url")
  coverImage   String?   @map("cover_image")
  description  String?
  settings     Json?
  isMain       Boolean   @default(false) @map("is_main")
  managerId    String?   @map("manager_id")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant         Restaurant               @relation(fields: [restaurantId], references: [id])
  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  manager            User?                    @relation("BranchManager", fields: [managerId], references: [id])
  users              User[]                   @relation("BranchUsers")
  staffRoles         StaffRole[]
  staffUsers         StaffUser[]
  menuItemOverrides  BranchMenuItemOverride[]
  categoryOverrides  BranchCategoryOverride[]
  inventoryMovements InventoryMovement[]
  coupons            Coupon[]
  carts              Cart[]
  orders             Order[]
  transactions        PaymentTransaction[]
  walletTransactions  WalletTransaction[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  deliverymen        Deliveryman[]
  chatThreads        ChatThread[]
  groupOrders        GroupOrderSession[]
  posOrderDrafts     PosOrderDraft[]

  @@map("branches")
}

model Address {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  referenceId    String              @map("reference_id")
  refType        AddressRefType      @map("ref_type")
  street         String
  area           String?
  city           String
  state          String
  country        String
  lat            Decimal?            @db.Decimal(10, 7)
  lng            Decimal?            @db.Decimal(10, 7)
  isActive       Boolean             @default(true) @map("is_active")
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  carts          Cart[]              @relation("CartDeliveryAddress")
  deliveryOrders Order[]             @relation("OrderDeliveryAddress")
  groupOrders    GroupOrderSession[] @relation("GroupOrderDeliveryAddress")

  @@index([referenceId, refType])
  @@map("addresses")
}

model User {
  id                        String    @id @default(cuid())
  email                     String
  password                  String
  role                      UserRole
  isVerified                Boolean   @default(false) @map("is_verified")
  isApproved                Boolean   @default(false) @map("is_approved")
  isGuest                   Boolean   @default(false) @map("is_guest")
  verificationToken         String?   @map("verification_token")
  verificationOtp           String?   @map("verification_otp")
  verificationOtpExpiresAt  DateTime? @map("verification_otp_expires_at") @db.Timestamptz
  verificationOtpAttempts   Int       @default(0) @map("verification_otp_attempts")
  resetPasswordOtp          String?   @map("reset_password_otp")
  resetPasswordOtpExpiresAt DateTime? @map("reset_password_otp_expires_at") @db.Timestamptz
  resetPasswordOtpAttempts  Int       @default(0) @map("reset_password_otp_attempts")
  refreshTokenHash          String?   @map("refresh_token_hash")
  deleteAfter               DateTime? @map("delete_after") @db.Timestamptz
  tenantId                  String?   @map("tenant_id")
  restaurantId              String?   @map("restaurant_id")
  branchId                  String?   @map("branch_id")
  isActive                  Boolean   @default(true) @map("is_active")
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenantOwned            Tenant[]                @relation("TenantOwner")
  tenant                 Tenant?                 @relation("TenantUsers", fields: [tenantId], references: [id])
  restaurant             Restaurant?             @relation("RestaurantUsers", fields: [restaurantId], references: [id])
  branch                 Branch?                 @relation("BranchUsers", fields: [branchId], references: [id])
  managedBranches        Branch[]                @relation("BranchManager")
  ownedStaffRoles        StaffRole[]             @relation("StaffRoleOwner")
  ownedStaffUsers        StaffUser[]             @relation("StaffUserOwner")
  profile                Profile?
  cart                   Cart?                   @relation("CustomerCart")
  createdMovements       InventoryMovement[]     @relation("MovementCreatedBy")
  customerOrders         Order[]                 @relation("OrderCustomer")
  posOrderDrafts         PosOrderDraft[]         @relation("PosDraftCustomer")
  couponUsages           CouponUsage[]
  walletAccounts         WalletAccount[]
  walletTransactions     WalletTransaction[]
  loyaltyAccounts        LoyaltyAccount[]
  loyaltyTransactions    LoyaltyTransaction[]
  receivedNotifications  Notification[]          @relation("NotificationRecipient")
  customerChatThreads    ChatThread[]            @relation("ChatThreadCustomer")
  sentChatMessages       ChatMessage[]           @relation("ChatMessageUserSender")
  hostedGroupOrders      GroupOrderSession[]     @relation("GroupOrderHost")
  groupOrderParticipants GroupOrderParticipant[]

  @@unique([email, restaurantId])
  @@map("users")
}

model Profile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  avatarUrl String?   @map("avatar_url")
  phone     String?
  bio       String?
  metadata  Json?
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model MenuCategory {
  id               String    @id @default(cuid())
  restaurantId     String    @map("restaurant_id")
  parentCategoryId String?   @map("parent_category_id")
  name             String
  slug             String
  description      String?
  imageUrl         String?   @map("image_url")
  sortOrder        Int       @default(0) @map("sort_order")
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id])
  parent       MenuCategory?            @relation("MenuCategoryTree", fields: [parentCategoryId], references: [id])
  children     MenuCategory[]           @relation("MenuCategoryTree")
  items        MenuItem[]
  menuLinks    RestaurantMenuCategory[]
  modifierLinks MenuCategoryModifierGroup[]
  overrides    BranchCategoryOverride[]
  couponScopes Coupon[]

  @@unique([restaurantId, slug])
  @@map("menu_categories")
}

model MenuItem {
  id                     String    @id @default(cuid())
  restaurantId           String    @map("restaurant_id")
  categoryId             String    @map("category_id")
  name                   String
  slug                   String
  description            String?
  ingredients            String?
  nutritionalInformation String?   @map("nutritional_information")
  imageUrl               String?   @map("image_url")
  sku                    String?
  pricingMode            MenuItemPricingMode @default(SINGLE) @map("pricing_mode")
  basePrice              Decimal   @default(0) @map("base_price") @db.Decimal(10, 2)
  deliveryPriceAdjustment Decimal  @default(0) @map("delivery_price_adjustment") @db.Decimal(10, 2)
  takeawayPriceAdjustment Decimal  @default(0) @map("takeaway_price_adjustment") @db.Decimal(10, 2)
  prepTimeMinutes        Int?      @map("prep_time_minutes")
  dietaryFlags           Json?     @map("dietary_flags")
  allergenFlags          Json?     @map("allergen_flags")
  depositAmount          Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  isActive               Boolean   @default(true) @map("is_active")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id])
  category        MenuCategory             @relation(fields: [categoryId], references: [id])
  menuLinks       RestaurantMenuItem[]
  variations      MenuItemVariation[]
  modifierLinks   MenuItemModifierGroup[]
  modifierPriceOverrides MenuItemModifierPriceOverride[]
  branchOverrides BranchMenuItemOverride[]
  recipes         MenuItemRecipe[]
  couponScopes    Coupon[]
  orderItems      OrderItem[]

  @@unique([restaurantId, slug])
  @@unique([restaurantId, sku])
  @@map("menu_items")
}

model RestaurantMenu {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  slug         String
  description  String?
  isTimed      Boolean   @default(false) @map("is_timed")
  timingConfig Json?     @map("timing_config")
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id])
  items      RestaurantMenuItem[]
  categories RestaurantMenuCategory[]
  carts      Cart[]
  groupOrderSessions GroupOrderSession[]

  @@unique([restaurantId, slug])
  @@map("restaurant_menus")
}

model RestaurantMenuCategory {
  id               String   @id @default(cuid())
  restaurantMenuId String   @map("restaurant_menu_id")
  menuCategoryId   String   @map("menu_category_id")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurantMenu RestaurantMenu @relation(fields: [restaurantMenuId], references: [id])
  menuCategory   MenuCategory   @relation(fields: [menuCategoryId], references: [id])

  @@unique([restaurantMenuId, menuCategoryId])
  @@map("restaurant_menu_categories")
}

model RestaurantMenuItem {
  id               String   @id @default(cuid())
  restaurantMenuId String   @map("restaurant_menu_id")
  menuItemId       String   @map("menu_item_id")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurantMenu RestaurantMenu @relation(fields: [restaurantMenuId], references: [id])
  menuItem       MenuItem       @relation(fields: [menuItemId], references: [id])

  @@unique([restaurantMenuId, menuItemId])
  @@map("restaurant_menu_items")
}

model MenuItemVariation {
  id          String    @id @default(cuid())
  menuItemId  String    @map("menu_item_id")
  name        String
  description String?
  requiredModifierId String? @map("required_modifier_id")
  sku         String?
  price       Decimal   @default(0) @db.Decimal(10, 2)
  sortOrder   Int       @default(0) @map("sort_order")
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  menuItem          MenuItem   @relation(fields: [menuItemId], references: [id])
  requiredModifier  Modifier?  @relation(fields: [requiredModifierId], references: [id])

  @@unique([menuItemId, name])
  @@map("menu_item_variations")
}

model MenuCategoryModifierGroup {
  id              String @id @default(cuid())
  categoryId      String @map("category_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  category      MenuCategory  @relation(fields: [categoryId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([categoryId, modifierGroupId])
  @@map("menu_category_modifier_groups")
}

model ModifierGroup {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  description  String?
  minSelect    Int       @default(0) @map("min_select")
  maxSelect    Int       @default(1) @map("max_select")
  isRequired   Boolean   @default(false) @map("is_required")
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id])
  modifiers  Modifier[]
  itemLinks  MenuItemModifierGroup[]
  categoryLinks MenuCategoryModifierGroup[]

  @@unique([restaurantId, name])
  @@map("modifier_groups")
}

model Modifier {
  id              String    @id @default(cuid())
  modifierGroupId String    @map("modifier_group_id")
  name            String
  priceDelta      Decimal   @default(0) @map("price_delta") @db.Decimal(10, 2)
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  modifierGroup       ModifierGroup                   @relation(fields: [modifierGroupId], references: [id])
  itemPriceOverrides  MenuItemModifierPriceOverride[]
  requiredByVariations MenuItemVariation[]

  @@unique([modifierGroupId, name])
  @@map("modifiers")
}

model MenuItemModifierGroup {
  id              String @id @default(cuid())
  menuItemId      String @map("menu_item_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model MenuItemModifierPriceOverride {
  id         String  @id @default(cuid())
  menuItemId String  @map("menu_item_id")
  modifierId String  @map("modifier_id")
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  modifier Modifier @relation(fields: [modifierId], references: [id])

  @@unique([menuItemId, modifierId])
  @@map("menu_item_modifier_price_overrides")
}

model BranchMenuItemOverride {
  id            String   @id @default(cuid())
  branchId      String   @map("branch_id")
  menuItemId    String   @map("menu_item_id")
  isAvailable   Boolean  @default(true) @map("is_available")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch   Branch   @relation(fields: [branchId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([branchId, menuItemId])
  @@map("branch_menu_item_overrides")
}

model BranchCategoryOverride {
  id             String   @id @default(cuid())
  branchId       String   @map("branch_id")
  menuCategoryId String   @map("menu_category_id")
  isVisible      Boolean  @default(true) @map("is_visible")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch       Branch       @relation(fields: [branchId], references: [id])
  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id])

  @@unique([branchId, menuCategoryId])
  @@map("branch_category_overrides")
}

model InventoryCategory {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  slug         String
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  items      InventoryItem[]

  @@unique([restaurantId, slug])
  @@map("inventory_categories")
}

model InventoryItem {
  id                  String    @id @default(cuid())
  restaurantId        String    @map("restaurant_id")
  inventoryCategoryId String?   @map("inventory_category_id")
  name                String
  sku                 String?
  unit                String
  currentQty          Decimal   @default(0) @map("current_qty") @db.Decimal(12, 3)
  reorderLevel        Decimal?  @map("reorder_level") @db.Decimal(12, 3)
  costPerUnit         Decimal?  @map("cost_per_unit") @db.Decimal(10, 2)
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id])
  category   InventoryCategory?  @relation(fields: [inventoryCategoryId], references: [id])
  movements  InventoryMovement[]
  recipes    MenuItemRecipe[]

  @@unique([restaurantId, sku])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String            @id @default(cuid())
  inventoryItemId String            @map("inventory_item_id")
