}

model GroupOrderParticipant {
  id        String                      @id @default(cuid())
  sessionId String                      @map("session_id")
  userId    String                      @map("user_id")
  isHost    Boolean                     @default(false) @map("is_host")
  status    GroupOrderParticipantStatus @default(ACTIVE)
  joinedAt  DateTime                    @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime?                   @map("left_at") @db.Timestamptz
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  session GroupOrderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id])
  items   GroupOrderItem[]

  @@unique([sessionId, userId])
  @@index([userId, status, joinedAt])
  @@map("group_order_participants")
}

model GroupOrderItem {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  participantId String   @map("participant_id")
  menuItemId    String   @map("menu_item_id")
  variationId   String?  @map("variation_id")
  quantity      Int
  note          String?
  modifiers     Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session     GroupOrderSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant GroupOrderParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([participantId, createdAt])
  @@map("group_order_items")
}


model PosOrderDraft {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  restaurantId     String             @map("restaurant_id")
  branchId         String             @map("branch_id")
  createdByActorId String             @map("created_by_actor_id")
  createdByActorType PosActorType     @map("created_by_actor_type")
  customerId       String?            @map("customer_id")
  orderType        OrderType          @map("order_type")
  paymentMethod    PaymentMethod?     @map("payment_method")
  guestName        String?            @map("guest_name")
  guestPhone       String?            @map("guest_phone")
  tableLabel       String?            @map("table_label")
  guestCount       Int?               @map("guest_count")
  couponCode       String?            @map("coupon_code")
  note             String?            @map("note")
  status           PosOrderDraftStatus @default(OPEN)
  checkedOutAt     DateTime?          @map("checked_out_at") @db.Timestamptz
  finalOrderId     String?            @map("final_order_id")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  branch    Branch        @relation(fields: [branchId], references: [id])
  customer  User?         @relation("PosDraftCustomer", fields: [customerId], references: [id])
  items     PosOrderDraftItem[]

  @@index([tenantId, branchId, status, createdAt])
  @@index([restaurantId, branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("pos_order_drafts")
}

model PosOrderDraftItem {
  id          String   @id @default(cuid())
  draftId      String   @map("draft_id")
  menuItemId   String   @map("menu_item_id")
  variationId  String?  @map("variation_id")
  quantity     Int
  note         String?
  modifiers    Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  draft PosOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("pos_order_draft_items")
}

model ChatThread {
  id                  String           @id @default(cuid())
  tenantId            String           @map("tenant_id")
  restaurantId        String           @map("restaurant_id")
  branchId            String?          @map("branch_id")
  customerId          String           @map("customer_id")
  orderId             String?          @map("order_id")
  deliverymanId       String?          @map("deliveryman_id")
  source              ChatThreadSource @default(SUPPORT)
  subject             String?
  status              ChatThreadStatus @default(OPEN)
  assignedStaffUserId String?          @map("assigned_staff_user_id")
  lastMessagePreview  String?          @map("last_message_preview")
  lastMessageAt       DateTime         @map("last_message_at") @db.Timestamptz
  customerUnreadCount Int              @default(0) @map("customer_unread_count")
  staffUnreadCount    Int              @default(0) @map("staff_unread_count")
  customerLastReadAt  DateTime?        @map("customer_last_read_at") @db.Timestamptz
  staffLastReadAt     DateTime?        @map("staff_last_read_at") @db.Timestamptz
  resolvedAt          DateTime?        @map("resolved_at") @db.Timestamptz
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id])
  branch        Branch?      @relation(fields: [branchId], references: [id])
  customer      User         @relation("ChatThreadCustomer", fields: [customerId], references: [id])
  order         Order?       @relation(fields: [orderId], references: [id])
  deliveryman   Deliveryman? @relation("ChatThreadDeliveryman", fields: [deliverymanId], references: [id])
  assignedStaff StaffUser?   @relation("ChatThreadAssignedStaff", fields: [assignedStaffUserId], references: [id])
  messages      ChatMessage[]

  @@index([tenantId, restaurantId, status, lastMessageAt])
  @@index([branchId, status, lastMessageAt])
  @@index([customerId, status, lastMessageAt])
  @@index([orderId, status, lastMessageAt])
  @@index([deliverymanId, status, lastMessageAt])
  @@index([assignedStaffUserId, status, lastMessageAt])
  @@map("chat_threads")
}

model ChatMessage {
  id                  String                @id @default(cuid())
  threadId            String                @map("thread_id")
  senderType          ChatMessageSenderType @map("sender_type")
  senderUserId        String?               @map("sender_user_id")
  senderStaffUserId   String?               @map("sender_staff_user_id")
  senderDeliverymanId String?               @map("sender_deliveryman_id")
  body                String
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz

  thread            ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser        User?        @relation("ChatMessageUserSender", fields: [senderUserId], references: [id])
  senderStaffUser   StaffUser?   @relation("ChatMessageStaffSender", fields: [senderStaffUserId], references: [id])
  senderDeliveryman Deliveryman? @relation("ChatMessageDeliverymanSender", fields: [senderDeliverymanId], references: [id])

  @@index([threadId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderStaffUserId, createdAt])
  @@index([senderDeliverymanId, createdAt])
  @@map("chat_messages")
}

model GlobalSetting {
  id                          String                @id @default(cuid())
  scopeKey                    String                @unique @default("GLOBAL") @map("scope_key") @db.VarChar(20)
  globalTaxPercentage         Decimal               @default(0) @map("global_tax_percentage") @db.Decimal(5, 2)
  vatHandlingRule             VatHandlingRule       @default(EXCLUSIVE) @map("vat_handling_rule")
  defaultCommissionPercentage Decimal               @default(0) @map("default_commission_percentage") @db.Decimal(5, 2)
  defaultHybridFeePercentage  Decimal               @default(0) @map("default_hybrid_fee_percentage") @db.Decimal(5, 2)
  defaultCurrency             String                @default("PKR") @map("default_currency") @db.VarChar(10)
  currencyDisplayFormat       CurrencyDisplayFormat @default(SYMBOL_AMOUNT) @map("currency_display_format")
  defaultLanguage             String                @default("en") @map("default_language") @db.VarChar(16)
  dateFormat                  PlatformDateFormat    @default(DD_MM_YYYY) @map("date_format")
  timezone                    String                @default("Asia/Karachi") @db.VarChar(100)
  primaryColor                String?               @map("primary_color") @db.VarChar(20)
  secondaryColor              String?               @map("secondary_color") @db.VarChar(20)
  fontFamily                  String?               @map("font_family") @db.VarChar(100)
  notificationSettings        Json?                 @map("notification_settings")
  isTaxEnforced               Boolean               @default(false) @map("is_tax_enforced")
  isCommissionEnforced        Boolean               @default(false) @map("is_commission_enforced")
  isCurrencyEnforced          Boolean               @default(false) @map("is_currency_enforced")
  isLocalizationEnforced      Boolean               @default(false) @map("is_localization_enforced")
  createdBy                   String?               @map("created_by") @db.VarChar(191)
  updatedBy                   String?               @map("updated_by") @db.VarChar(191)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@map("global_settings")
}

model Notification {
  id                   String               @id @default(cuid())
  tenantId             String               @map("tenant_id")
  restaurantId         String               @map("restaurant_id")
  branchId             String               @map("branch_id")
  orderId              String?              @map("order_id")
  paymentTransactionId String?              @map("payment_transaction_id")
  recipientUserId      String?              @map("recipient_user_id")
  recipientEmail       String?              @map("recipient_email")
  channel              NotificationChannel  @default(EMAIL)
  audience             NotificationAudience @default(CUSTOMER)
  type                 NotificationType     @map("type")
  subject              String
  body                 String
  payload              Json?
  status               NotificationStatus   @default(PENDING)
  sentAt               DateTime?            @map("sent_at") @db.Timestamptz
  failedAt             DateTime?            @map("failed_at") @db.Timestamptz
  seenAt               DateTime?            @map("seen_at") @db.Timestamptz
  errorMessage         String?              @map("error_message")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id])
  branch             Branch              @relation(fields: [branchId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  recipientUser      User?               @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([restaurantId, branchId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([audience, recipientUserId, createdAt])
  @@index([audience, restaurantId, branchId, createdAt])
  @@index([audience, seenAt, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentTransactionId, createdAt])
  @@map("notifications")
}
